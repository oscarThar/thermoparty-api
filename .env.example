# ── SERVER ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ─────────────────────────────────
JWT_SECRET=cambia_esto_por_algo_largo_y_random
JWT_EXPIRES_IN=8h

# ── MYSQL ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=thermoparty
DB_USER=thermoparty_user
DB_PASSWORD=tu_password_aqui

# ── DYNAMICS 365 ────────────────────────
# Tenant ID de tu Azure AD
D365_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# App registration en Azure AD
D365_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
D365_CLIENT_SECRET=tu_client_secret_aqui
# URL de tu instancia D365 (ej: https://tharsa.crm2.dynamics.com)
D365_INSTANCE_URL=https://tu-instancia.crm.dynamics.com

# ── CORS ────────────────────────────────
# Origen del frontend (en prod: tu dominio real)
FRONTEND_URL=http://localhost:5500
